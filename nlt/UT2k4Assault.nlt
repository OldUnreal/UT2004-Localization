[ASGameInfo]
; EN: ASPropsDisplayText[0]="Pair of Rounds"
ASPropsDisplayText[0]="Rondeparen"
; EN: ASPropsDisplayText[1]="Round Time Limit"
ASPropsDisplayText[1]="Tijdslimiet ronde"
