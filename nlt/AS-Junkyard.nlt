; EN: Objective_Info_Attacker="Cross the bridge"
Objective_Info_Attacker="Steek de brug over"
; EN: Objective_Info_Defender="Defend the bridge"
Objective_Info_Defender="Verdedig de brug"

[ProximityObjective3]
