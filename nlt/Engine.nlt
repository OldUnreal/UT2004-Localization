[MasterMD5Commandlet]
HelpCmd=mastermd5
; EN: HelpOneLiner=Manipulate the Master MD5 database
HelpOneLiner=Bewerk de master-MD5-database
; EN: HelpUsage=mastermd5 [-option..] <params>
HelpUsage=mastermd5 [-optie..] <parameters>
HelpWebLink=http://unreal.epicgames.com/servertips.htm
HelpParm[0]=-c
; EN: HelpDesc[0]=Creates a new MD5 database
HelpDesc[0]=Maakt een nieuwe MD5-database aan
HelpParm[1]=-a
; EN: HelpDesc[1]=Adds new packages to the database
HelpDesc[1]=Voegt nieuwe pakketten toe aan de database
HelpParm[2]=-s
; EN: HelpDesc[2]=Show the current database.
HelpDesc[2]=Toon de huidige database.
HelpParm[3]=-r
; EN: HelpDesc[3]=Force the revision of all entries to <param>
HelpDesc[3]=Forceer de revisie van alle items naar <param>

[UModUnpackCommandlet]
HelpCmd=umodunpack
; EN: HelpOneLiner=Unpack UMOD files
HelpOneLiner=UMOD-bestanden uitpakken
; EN: HelpUsage=umodunpack [-option] <filename>
HelpUsage=umodunpack [-optie] <bestandsnaam>
HelpWebLink=http://unreal.epicgames.com/servertips.htm
HelpParm[0]=-x
; EN: HelpDesc[0]=Extract files from <filename>
HelpDesc[0]=Pak bestanden uit <bestandsnaam> uit
HelpParm[1]=-l
; EN: HelpDesc[1]=List files in <filename> without extracting.
HelpDesc[1]=Toon bestanden in <bestandsnaam> zonder uit te pakken.

[ServerCommandlet]
HelpCmd=server
; EN: HelpOneLiner=Network game server
HelpOneLiner=Netwerkspelserver
; EN: HelpUsage=server map.unr[?game=gametype] [-option...] [parm=value]...
HelpUsage=server map.unr[?game=speltype] [-optie...] [parm=waarde]...
HelpWebLink=http://unreal.epicgames.com/servertips.htm
HelpParm[0]=Log
; EN: HelpDesc[0]=Specify the log file to generate
HelpDesc[0]=Geef het logbestand op dat moet worden aangemaakt
HelpParm[1]=AllAdmin
; EN: HelpDesc[1]=Give all players admin priveleges
HelpDesc[1]=Geef alle spelers beheerdersrechten

[ExportCacheCommandlet]
HelpCmd=exportcache
; EN: HelpOneLIner=Generates cache record entries for the specified packages.
HelpOneLIner=Genereert cacherecords voor de opgegeven pakketten.
; EN: HelpUsage=exportcache [-a] [-y] [-v] <package.ext> [package.ext...] [destfilename.ucl]
HelpUsage=exportcache [-a] [-y] [-v] <pakket.ext> [pakket.ext...] [doelbestandsnaam.ucl]
HelpWebLink=http://unreal.epicgames.com/unrealcaching.htm
HelpParm[0]=-a
HelpParm[1]=-y
HelpParm[2]=-v
; EN: HelpParm[3]=package.ext
HelpParm[3]=pakket.ext
; EN: HelpParm[4]=destfilename.ucl
HelpParm[4]=doelbestandsnaam.ucl
; EN: HelpDesc[0]=Update matching entries in destfilename.ucl.  Append any new entries.
HelpDesc[0]=Werk overeenkomende items in doelbestandsnaam.ucl bij.  Voeg nieuwe items toe.
; EN: HelpDesc[1]=Automatically answer 'Yes' to any prompts during the operation.
HelpDesc[1]=Beantwoord vragen tijdens de bewerking automatisch met 'Ja'.
; EN: HelpDesc[2]=Verbose output (to ucc.log)
HelpDesc[2]=Uitgebreide uitvoer (naar ucc.log)
; EN: HelpDesc[3]=Space delimited list of packages (including extension) that should be exported.  Wildcards are supported.  Paths are not required.
HelpDesc[3]=Door spaties gescheiden lijst van pakketten (inclusief extensie) die moeten worden geëxporteerd.  Jokertekens worden ondersteund.  Paden zijn niet nodig.
; EN: HelpDesc[4]=Destination file for exported entries.  Default filename is the name of the package being exported.  To export multiple packages to a single .ucl file, you must specify a destination filename.
HelpDesc[4]=Doelbestand voor geëxporteerde items.  Standaard is de bestandsnaam de naam van het geëxporteerde pakket.  Om meerdere pakketten naar één .ucl-bestand te exporteren, moet je een doelbestandsnaam opgeven.

