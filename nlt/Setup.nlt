[Errors]
; EN: MissingProductTitle="%s can't be %s in this folder"
MissingProductTitle="%s kan in deze map niet worden %s"
; EN: MissingProductInstalled="installed"
MissingProductInstalled="geïnstalleerd"
; EN: MissingProductPatched="updated"
MissingProductPatched="bijgewerkt"
; EN: MissingProductThis="This update"
MissingProductThis="Deze update"
; EN: MissingProduct="%s requires %s to be installed in the folder first. Please locate the existing folder for %s, or exit and install it now.\n\nYou can click on the web link below for product information."
MissingProduct="Voor %s moet %s eerst in de map geïnstalleerd zijn. Zoek de bestaande map voor %s op, of sluit af en installeer het nu.\n\nKlik op de weblink hieronder voor productinformatie."
; EN: OldVersion="%s requires %s version %i or later, but the version on your machine is older (you have version %i). Please install %s version %i or later and try again. You can click on the web link below for more information.\n\nSetup will now exit."
OldVersion="Voor %s is %s versie %i of later nodig, maar de versie op je computer is ouder (je hebt versie %i). Installeer %s versie %i of later en probeer het opnieuw. Klik op de weblink hieronder voor meer informatie.\n\nSetup wordt nu afgesloten."
; EN: FolderTitle="Folder %s"
FolderTitle="Map %s"
; EN: FolderFormat="The folder you entered, %s, is not valid.  Please try again."
FolderFormat="De ingevoerde map, %s, is ongeldig.  Probeer het opnieuw."
; EN: CDKeyTitle="Invalid CD Key"
CDKeyTitle="Ongeldige cd-sleutel"
; EN: CDKeyFormat="The CD key you entered was not correct.  Please re-check your CD key against the number printed on the back of your manual and try again."
CDKeyFormat="De ingevoerde cd-sleutel is onjuist.  Vergelijk je cd-sleutel met het nummer op de achterkant van je handleiding en probeer het opnieuw."
; EN: AlreadyRunningTitle="Can't Install While In Use"
AlreadyRunningTitle="Kan niet installeren tijdens gebruik"
; EN: AlreadyRunning="To continue the installation process, please shut down all other running copies and press OK.  To exit, press Cancel."
AlreadyRunning="Sluit alle andere geopende exemplaren af en druk op OK om de installatie voort te zetten.  Druk op Annuleren om af te sluiten."
; EN: WrongCdTitle="Files Not Found On CD-ROM"
WrongCdTitle="Bestanden niet gevonden op cd-rom"
; EN: WrongCd="The expected version of %s file %s was not found on the CD-ROM drive.\n\nPlease verify that the proper CD is in the drive."
WrongCd="De verwachte versie van %s-bestand %s is niet gevonden in het cd-romstation.\n\nControleer of de juiste cd in het station zit."
; EN: MissingInstallerFile="Installer file not found"
MissingInstallerFile="Installatiebestand niet gevonden"
; EN: MissingReferenceFile="Reference file not found"
MissingReferenceFile="Referentiebestand niet gevonden"
; EN: MissingSourceFile="Source file not found"
MissingSourceFile="Bronbestand niet gevonden"
; EN: FailedOpenSource="Failed opening source file"
FailedOpenSource="Openen van bronbestand mislukt"
; EN: FailedOpenDest="Failed opening destination file"
FailedOpenDest="Openen van doelbestand mislukt"
; EN: FailedReadingSource="Failed reading source file"
FailedReadingSource="Lezen van bronbestand mislukt"
; EN: FailedWritingDest="Failed writing destination file"
FailedWritingDest="Schrijven van doelbestand mislukt"
; EN: FailedLoadingUpdate="Failed loading update file"
FailedLoadingUpdate="Laden van updatebestand mislukt"
; EN: FailedReadingReference="Failed reading reference file"
FailedReadingReference="Lezen van referentiebestand mislukt"
; EN: FailedClosingSource="Failed closing source file"
FailedClosingSource="Sluiten van bronbestand mislukt"
; EN: FailedClosingDest="Failed closing destination file"
FailedClosingDest="Sluiten van doelbestand mislukt"
; EN: FailedMakeDir="Failed making directory for destination file"
FailedMakeDir="Aanmaken van map voor doelbestand mislukt"
; EN: AdviseBadMedia="The source media may be bad.  If installing from a CD, try cleaning the CD to remove any dirt, check your CD drive, and try again."
AdviseBadMedia="Het bronmedium is mogelijk beschadigd.  Installeer je vanaf cd, maak de cd dan schoon, controleer je cd-station en probeer het opnieuw."
; EN: AdviseBadDownload="The update files you downloaded may be corrupted."
AdviseBadDownload="De gedownloade updatebestanden zijn mogelijk beschadigd."
; EN: AdviseBadDest="The destination drive might be full, or it might have bad sectors."
AdviseBadDest="Het doelstation is mogelijk vol of heeft beschadigde sectoren."
; EN: PatchCorrupt="The patch file %s is corrupt.\n\n%s"
PatchCorrupt="Het patchbestand %s is beschadigd.\n\n%s"
; EN: CdFileMismatch="The file %s from the CD-ROM is not the expected version. Therefore, %s can't be patched."
CdFileMismatch="Het bestand %s op de cd-rom is niet de verwachte versie. Daarom kan %s niet worden gepatcht."

[General]
; EN: Space="%i Megabytes"
Space="%i megabyte"
; EN: Ready="Setup is ready to install %s.\nThe destination folder is: %s\n\nClick 'Install' to begin installation.\nClick 'Cancel' to exit without installing %s."
Ready="Setup is klaar om %s te installeren.\nDe doelmap is: %s\n\nKlik op 'Installeren' om de installatie te starten.\nKlik op 'Annuleren' om af te sluiten zonder %s te installeren."
; EN: InstallCancel="Cancel Installation"
InstallCancel="Installatie annuleren"
; EN: CancelPrompt="Warning!  Canceling the installation now will prevent %s from functioning properly.  Are you sure you want to cancel it?"
CancelPrompt="Waarschuwing!  Als je de installatie nu annuleert, werkt %s niet goed.  Weet je zeker dat je wilt annuleren?"
; EN: DidCancel="You cancelled installation.  The product has not been successfully installed and will not function correctly."
DidCancel="Je hebt de installatie geannuleerd.  Het product is niet goed geïnstalleerd en werkt niet correct."
; EN: CdDescription="To install the %s update, some files must be copied off the original %s CD-ROM.\n\nPlease place the %s CD-ROM in your drive, and click 'Next'.  If your CD drive letter is shown incorrectly, please enter it below."
CdDescription="Om de update van %s te installeren, moeten enkele bestanden van de originele cd-rom van %s worden gekopieerd.\n\nPlaats de cd-rom van %s in je station en klik op 'Volgende'.  Als de stationsletter van je cd-station onjuist wordt weergegeven, voer hem dan hieronder in."
; EN: CdDrive="CD-ROM Drive"
CdDrive="Cd-romstation"
; EN: NotEnoughSpaceTitle="Can't Install There"
NotEnoughSpaceTitle="Kan daar niet installeren"
; EN: NotEnoughSpace="There is not enough space available on drive %s to install %s.  Please select a drive with more free space, or exit, free up more space, and try again."
NotEnoughSpace="Er is niet genoeg ruimte op station %s om %s te installeren.  Kies een station met meer vrije ruimte, of sluit af, maak ruimte vrij en probeer het opnieuw."
; EN: Finish="&Finish"
Finish="&Voltooien"
; EN: RebootButton="&Reboot"
RebootButton="&Opnieuw opstarten"
; EN: ExitButton="&Exit"
ExitButton="&Afsluiten"
Abbreviation="UT2004 Setup"
; EN: CDPromptTitle="Waiting for CD"
CDPromptTitle="Wachten op cd"
; EN: CDPromptMessage="Please insert Unreal Tournament 2004 CD number %d"
CDPromptMessage="Plaats cd nummer %d van Unreal Tournament 2004"
; EN: LastCDPromptMessage="Please insert Unreal Tournament 2004 CD number 6"
LastCDPromptMessage="Plaats cd nummer 6 van Unreal Tournament 2004"
; EN: InstallQFE="Unreal Tournament 2004 Setup needs to install an update to DirectX 8.1.  Please follow the instructions in the following dialog box."
InstallQFE="Setup van Unreal Tournament 2004 moet een update voor DirectX 8.1 installeren.  Volg de instructies in het volgende dialoogvenster."
; EN: ECEPromptTitle="Waiting for CD"
ECEPromptTitle="Wachten op cd"
; EN: ECEPromptMessage="Please insert the Mod Installer Disc 1"
ECEPromptMessage="Plaats Mod Installer Disc 1"

