LMSPropsDisplayText[2]="Gezondheid voor kills"
; EN: LMSPropsDisplayText[3]="Allow SuperWeapons"
LMSPropsDisplayText[3]="Superwapens toestaan"
; EN: LMSPropsDisplayText[4]="Camper Alarm"
LMSPropsDisplayText[4]="Kampeeralarm"
; EN: LMSPropsDisplayText[5]="Allow Pickups"
